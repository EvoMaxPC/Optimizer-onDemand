<Window x:Class="EVO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVO BOTTLENECK DETECTOR"
        Height="640" Width="1000" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource EVOBlack}">
    <Grid Margin="0" Background="{StaticResource EVOBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource EVOPanel}"
                BorderBrush="{StaticResource EVOYellow}" BorderThickness="0,0,0,3"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource EVOYellow}"
                            Margin="0,0,16,0">
                        <TextBlock Text="EVO" FontSize="16" FontWeight="Bold" Foreground="#0A0A0A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="EVO BOTTLENECK" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource EVOWhite}"/>
                        <TextBlock Text="DETECTOR" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource EVOYellow}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="WINDOWS PERFORMANCE INTELLIGENCE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource EVOCyan}" HorizontalAlignment="Right"/>
                    <TextBlock Text="ETAPA 01 — FOUNDATION" FontSize="11" Foreground="{StaticResource EVOGray}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" Margin="24,20,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="720" HorizontalAlignment="Center">
                <TextBlock Text="¿Qué está frenando realmente tu Windows y por qué?"
                           FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource EVOWhite}"
                           TextWrapping="Wrap" Margin="0,4,0,14"/>

                <TextBlock FontSize="13" Foreground="{StaticResource EVOGray}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18">
                    <Run>EVO no muestra porcentajes: investiga el sistema, localiza evidencias,</Run>
                    <Run Text=" establezca causas probables" />
                    <Run> y distingue entre</Run>
                    <Run Text=" problema confirmado, probable, advertencia, comportamiento normal y datos insuficientes" FontWeight="SemiBold" Foreground="{StaticResource EVOWhite}" />
                    <Run>. NO ADIVINAMOS. INVESTIGAMOS.</Run>
                </TextBlock>

                <Border Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CHECKPOINTS — ETAPA 01" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource EVOCyan}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F01" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Entorno y estructura verificados — Verificado"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F02" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Solución y proyectos — Verificado"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F03" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Referencias y dependencias — Verificado"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F04" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Contratos y modelos — Verificado"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F05" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Configuración y logging — Verificado (ejecución pendiente)"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="92" Background="{StaticResource EVOPanelLight}" CornerRadius="6" Padding="8,6" Margin="0,4,8,4">
                                <TextBlock Text="F06" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Pruebas y compilación — Pendiente (Windows + .NET 10 SDK)"
                                       FontSize="12" Foreground="{StaticResource EVOWhite}" VerticalAlignment="Center" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="NO ADIVINAMOS. INVESTIGAMOS. — EVO LABS" FontSize="12"
                           Foreground="{StaticResource EVOGrayLight}" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource EVOPanel}" BorderBrush="{StaticResource EVOGrayLight}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="EVO BOTTLENECK DETECTOR · Verificación de FOUNDATION en progreso — ver docs/Technical/FOUNDATION.md"
                           FontSize="11" Foreground="{StaticResource EVOGray}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="EVO LABS" FontSize="11" FontWeight="Bold"
                            Foreground="{StaticResource EVOCyan}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
