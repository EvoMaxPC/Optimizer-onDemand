<Window x:Class="EVO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EVO.Desktop.Converters"
        Title="EVO BOTTLENECK DETECTOR"
        Height="760" Width="1100" MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource EVOBlack}">
    <Grid Margin="0" Background="{StaticResource EVOBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource EVOPanel}"
                BorderBrush="{StaticResource EVOYellow}" BorderThickness="0,0,0,3"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource EVOYellow}" Margin="0,0,16,0">
                        <TextBlock Text="EVO" FontSize="16" FontWeight="Bold" Foreground="#0A0A0A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="EVO BOTTLENECK" FontSize="24" FontWeight="Bold" Foreground="{StaticResource EVOWhite}"/>
                        <TextBlock Text="DETECTOR" FontSize="24" FontWeight="Bold" Foreground="{StaticResource EVOYellow}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="WINDOWS PERFORMANCE INTELLIGENCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EVOCyan}" HorizontalAlignment="Right"/>
                    <TextBlock Text="V1.0 — INFORME + MONITORIZACIÓN" FontSize="11" Foreground="{StaticResource EVOGray}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="24,18,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: métricas -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="22" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ESTADO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Status}" FontSize="15" Foreground="{StaticResource EVOWhite}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Button Content="RECOLECTAR" Command="{Binding RunAnalysisCommand}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertedBool}}"
                                    Background="{StaticResource EVOYellow}" Foreground="#0A0A0A"
                                    FontSize="13" FontWeight="Bold" Padding="18,10" Cursor="Hand"
                                    BorderThickness="0" CornerRadius="8"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MÉTRICAS (M02 / M03 / M05 / M06 / M11 / M12)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,8,0,10"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource EVOGray}"/>
                                <TextBlock Text="{Binding CpuUsage}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM disponible" FontSize="11" Foreground="{StaticResource EVOGray}"/>
                                <TextBlock Text="{Binding RamAvailable}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="GPUs" FontSize="11" Foreground="{StaticResource EVOGray}"/>
                                <TextBlock Text="{Binding GpuAdapters}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Red (enviado)" FontSize="11" Foreground="{StaticResource EVOGray}"/>
                                <TextBlock Text="{Binding NetworkBytes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Border Grid.Column="0" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="14" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Eventos 24h" FontSize="11" Foreground="{StaticResource EVOGray}"/>
                                <TextBlock Text="{Binding HealthEvents}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource EVOYellow}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource EVOPanelLight}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HALLAZGOS M14 — correlación (confianza honesta)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding FindingsSummary}" FontSize="13" Foreground="{StaticResource EVOWhite}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource EVOPanel}" BorderBrush="{StaticResource EVOYellow}" BorderThickness="0,0,0,2" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EVOYellow}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource EVOWhite}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource EVOGray}">
                                                    <Run Text="Confianza: "/>
                                                    <Run Text="{Binding Confidence}" FontWeight="SemiBold" Foreground="{StaticResource EVOWhite}"/>
                                                    <Run Text=" · Severidad: "/>
                                                    <Run Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{StaticResource EVOWhite}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: informe JSON -->
            <Border Grid.Column="1" Background="{StaticResource EVOPanel}" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="INFORME M15 (JSON)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" Margin="0,0,0,10"/>
                    <Border Background="#0A0A0A" CornerRadius="8" Padding="12" MinHeight="280">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <TextBlock Text="{Binding ReportJson}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource EVOWhite}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource EVOPanel}" BorderBrush="{StaticResource EVOGrayLight}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource EVOGray}" VerticalAlignment="Center">
                    <Run Text="EVO BOTTLENECK DETECTOR · Última recolección: "/>
                    <Run Text="{Binding LastRun}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="EVO LABS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EVOCyan}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool"/>
    </Window.Resources>
</Window>
