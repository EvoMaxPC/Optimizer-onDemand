<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EVO.Desktop</RootNamespace>
    <AssemblyName>EVO.Desktop</AssemblyName>
    <Version>0.1.0</Version>
    <Company>EVO LABS</Company>
    <Product>EVO BOTTLENECK DETECTOR</Product>
    <Description>Shell WPF de EVO BOTTLENECK DETECTOR.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EVO.Core\EVO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\appsettings.json" Link="config\appsettings.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
